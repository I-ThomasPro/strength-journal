# Copy to backend/.env and adjust as needed. These defaults match docker-compose.yml.
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/strength_journal
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/strength_journal_test

# The frontend's origin; unsafe requests from any other Origin are rejected
ALLOWED_ORIGIN=http://localhost:5173
# Session cookies are Secure (HTTPS-only) by default; plain-HTTP local development needs false
COOKIE_SECURE=false
SESSION_DAYS=30
